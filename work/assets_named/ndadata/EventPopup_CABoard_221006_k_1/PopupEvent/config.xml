			<!-- Button 종류
				 0: 디폴트 버튼, 사용하지 마세요.
				 1: 마이페이지, config=0 으로 메인탭 선택
				 2: 샵이동, config0, config1로 메인탭, 서브탭 선택
				 3: 튜토리얼 팝업, config0, config1로 메인탭, 서브탭 선택
				 4: 샵검색, search 으로 검색이름 설정
				 쾅쾅(예시)
			     		<Button type="4" img="PopupEvent/NoticeBoard_BT_01.bmp" search="쾅쾅"/>
				 5: 방생성, gametype, maptheme로 지정
				 6: 링크버튼, 특정 커스텀 기능 수행
					 뽀끼뽀끼(예시)
							<Button type="6" img="PopupEvent/BbokkiBbokki.bmp" link="Bbokki"/>
					 시간의상점(예시)
							<Button type="6" img="PopupEvent/TimeShop_Bt.bmp" link="TimeLimitShop"/>
					크아미션(예시)
							<Button type="6" img="PopupEvent/CAMission.bmp" link="CAMission"/>
				 7: 일반 퀘스트 창 오픈, quest 으로 설정
				 	<Button type="7" img="PopupEvent/WeekendEvent_Go_Bt.bmp" quest="WeekendCp2"/>
				 8: URL 링크 버튼, 특정 website 오픈, url 로 설정
				 	<Button type="8" img="PopupEvent/NoticeBoard_20140724_4_BT.bmp" url="http://ca.nexon.com/board/2097152023/978/" explain="WebPage"/>
				 9: 버튼클릭 시, 미동작 버튼타입
					<Button type="9" img="PopupEvent/NoticeBoard_BT_05.bmp"/>
			-->

			<!-- 버튼 이미지 -------------------------------------------------------------------------------------------------------------------------------------->

			<!-- [매출] 시간의상점 : 10/06 ~ 11/02 -->
			<Button type="6" img="PopupEvent/TimeShop_Bt.bmp" link="TimeLimitShop"/>
			
