			<Static img="PopupEvent/NoticeBoard_9.jpg"/>

			<!-- [패션왕] 09월  -->			
			<Static img="PopupEvent/NoticeBoard_20220908.jpg"/>			
			
			</MainImages>
		<Texts>
			<Static text="NotShowAgainEvent" x="391" y="481" bold="1"/>
