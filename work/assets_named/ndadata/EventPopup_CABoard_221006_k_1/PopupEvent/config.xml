			<Button type="7" img="PopupEvent/StampKing_BT.bmp" quest="StampKing3"/>		

			<!-- [컨텐츠] 클럽DJ를 잡아라 : 10/06 ~ 10/19 -->
			<Button type="9" img="PopupEvent/NoticeBoard_202201006_3_Bt.bmp"/>	

			<!-- [컨텐츠] 크아미션 : 09/01 ~ 09/28 -->
			<Button type="6" img="PopupEvent/CAMission.bmp" link="CAMission"/>			
	
			<!-- [이벤트] 01월 주말 핫타임 : 연중 -->
