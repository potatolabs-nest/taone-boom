			<Static img="PopupEvent/NoticeBoard_20220901_5.jpg"/>

			<!-- [퀘스트] 도전 출석왕 : 10/06 ~ 10/26 -->
			<Static img="PopupEvent/NoticeBoard_202201006_2.jpg"/>	

			<!-- [컨텐츠] 클럽DJ를 잡아라 : 10/06 ~ 10/19 -->
			<Static img="PopupEvent/NoticeBoard_202201006_3.jpg"/>	

			<!-- [컨텐츠] 크아미션 :  10/06 -->
			<Static img="PopupEvent/NoticeBoard_20221006.jpg"/>	

